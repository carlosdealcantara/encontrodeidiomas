# ============================================================
# ENCONTRO DE IDIOMAS - Variáveis de Ambiente (Modelo)
# ============================================================
# INSTRUÇÕES: Copie este arquivo para ".env" e preencha
# os valores reais. NUNCA comite o arquivo ".env" no Git.
# ============================================================

# Banco de Dados (Hostinger)
DB_HOST=localhost
DB_NAME=seu_banco_aqui
DB_USER=seu_usuario_aqui
DB_PASS=sua_senha_aqui

# Configurações do Site
SITE_NAME=Encontro de Idiomas
ADMIN_EMAIL=seu@email.com

# Bot de Telegram (Monitor Pessoal)
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# === PIPELINE GOOGLE DRIVE -> ODYSEE ===
GOOGLE_SERVICE_ACCOUNT_JSON=/caminho/para/google_service_account.json
DRIVE_RECORDINGS_FOLDER_ID=ID_da_pasta_Encontros_Gravados_no_Drive
LBRY_RPC_URL=http://localhost:5279
LBRY_WALLET_PASSWORD=
